# ── Which control plane to drive ──────────────────────────────────────────
# Leave ANTHROPIC_BASE_URL unset to use Anthropic's hosted Managed Agents API
# (the default). Set it to a self-hosted, wire-compatible control plane — e.g.
# managed-agent-platform's docker-compose stack — to keep everything local.
#
# Hosted Anthropic:
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Self-hosted control plane on this machine:
#   ANTHROPIC_BASE_URL=http://localhost:8080
#   ANTHROPIC_API_KEY=<that deployment's CONTROLPLANE_API_KEY>

ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=http://localhost:8080

# ── Which model the agent runs on ─────────────────────────────────────────
# Against api.anthropic.com this must be a real Claude model id. Against a
# self-hosted deployment it is whatever that deployment routes — e.g.
# managed-agent-platform's model-providers.json.
MODEL_ID=claude-opus-4-7
